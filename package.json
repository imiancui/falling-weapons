{
  "name": "falling-weapons",
  "version": "0.1.0",
  "private": true,
  "description": "Match-3 x falling physics weapons mining game (inspired by vycdev/falling-pickaxe)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "share": "powershell -ExecutionPolicy Bypass -File scripts/tailscale-up.ps1",
    "share:bg": "powershell -ExecutionPolicy Bypass -File scripts/tailscale-up.ps1 -Background",
    "unshare": "powershell -ExecutionPolicy Bypass -File scripts/tailscale-down.ps1"
  },
  "dependencies": {
    "matter-js": "^0.20.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/matter-js": "^0.20.2",
    "@types/three": "^0.187.0",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
